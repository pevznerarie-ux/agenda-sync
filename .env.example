# Copiez ce fichier en ".env" et remplissez les valeurs avant de lancer le serveur.

# --- Serveur ---
PORT=3000
BASE_URL=http://localhost:3000
SESSION_SECRET=changez-moi-en-une-longue-chaine-aleatoire

# --- Google Cloud OAuth (console.cloud.google.com > API et services > Identifiants) ---
# Type: ID client OAuth "Application Web"
# URI de redirection autorisee: ${BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Les personnes a synchroniser ---
# Un bloc DIRECTOR_N_* par personne (N = 1, 2, 3... dans l'ordre d'affichage).
# Ces valeurs ne servent qu'a AMORCER la liste au tout premier demarrage (des
# que data/db.json existe, la liste reelle est geree depuis /admin.html et ces
# variables sont ignorees).
# id: identifiant technique utilise dans les URLs (pas d'espaces/accents)
# name: nom affiche sur la page d'accueil
# role: intitule affiche sous le nom (libre)
# email: adresse a laquelle envoyer les rappels
# pin: code personnel pour se connecter au tableau de bord (4 caracteres min.
#      recommande) - A CHANGER apres le premier demarrage, depuis /admin.html
#      si vous etes admin, ou en redemandant a l'admin de le reinitialiser.
# admin: "true" pour pouvoir ajouter/supprimer des profils depuis /admin.html
DIRECTOR_1_ID=atlan
DIRECTOR_1_NAME=Yohan Atlan
DIRECTOR_1_ROLE=Directeur du Primaire
DIRECTOR_1_EMAIL=atlan@exemple.org
DIRECTOR_1_PIN=4127

DIRECTOR_2_ID=nemni
DIRECTOR_2_NAME=Simha Nemni
DIRECTOR_2_ROLE=Direction du College/Lycee
DIRECTOR_2_EMAIL=nemni@exemple.org
DIRECTOR_2_PIN=8563

DIRECTOR_3_ID=cohen
DIRECTOR_3_NAME=Moche Cohen
DIRECTOR_3_ROLE=Intendant
DIRECTOR_3_EMAIL=cohen@exemple.org
DIRECTOR_3_PIN=2940

DIRECTOR_4_ID=surveillance-college-lycee
DIRECTOR_4_NAME=Surveillance College Lycee
DIRECTOR_4_ROLE=
DIRECTOR_4_EMAIL=surveillance@exemple.org
DIRECTOR_4_PIN=7305

DIRECTOR_5_ID=rav-arie
DIRECTOR_5_NAME=Rav Arie
DIRECTOR_5_ROLE=Direction generale
DIRECTOR_5_EMAIL=arie@exemple.org
DIRECTOR_5_PIN=9481
DIRECTOR_5_ADMIN=true

# --- Calendrier partage pour les visites de salle ---
# Creez un calendrier Google dedie ("Salle de visite CNJ"), partagez-le avec le compte
# Google du DIRECTOR_ROOM_OWNER_ID ci-dessous en lui donnant le droit "Apporter des
# modifications aux evenements", puis collez son ID de calendrier ici (Parametres du
# calendrier > Integrer l'agenda > ID du calendrier).
ROOM_CALENDAR_ID=
ROOM_CALENDAR_NAME=Salle de visite
ROOM_OWNER_DIRECTOR_ID=rav-arie

# --- Acces au poste d'accueil ---
# Code partage demande a l'ecran d'accueil du gardien (poste tablette).
# Chaque membre de la direction a son propre code personnel (DIRECTOR_N_PIN
# ci-dessus) au lieu d'un mot de passe partage.
GATEKEEPER_PIN=1234

# --- Envoi des emails de rappel (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Accueil CNJ <accueil@exemple.org>"

# Nombre de minutes avant le rendez-vous auquel envoyer le rappel email
REMINDER_MINUTES_BEFORE=10

# --- Mode demonstration ---
# A true: remplace les vrais rendez-vous Google par des rendez-vous fictifs
# (2 par profil + 1 visite de salle), pour previsualiser le tableau de bord
# et le poste d'accueil sans avoir connecte de compte Google. Aucun email de
# rappel n'est jamais envoye pour ces rendez-vous de demo. Remettre a false
# avant la mise en production.
DEMO_MODE=false
