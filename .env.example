# Copiez ce fichier en ".env" et remplissez les valeurs avant de lancer le serveur.

# --- Serveur ---
PORT=3000
BASE_URL=http://localhost:3000
SESSION_SECRET=changez-moi-en-une-longue-chaine-aleatoire

# --- Google Cloud OAuth (console.cloud.google.com > API et services > Identifiants) ---
# Type: ID client OAuth "Application Web"
# URI de redirection autorisee: ${BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Les personnes a synchroniser ---
# Un bloc DIRECTOR_N_* par personne (N = 1, 2, 3... dans l'ordre d'affichage).
# id: identifiant technique utilise dans les URLs (pas d'espaces/accents)
# name: nom affiche sur la page d'accueil
# role: intitule affiche sous le nom (libre)
# email: adresse a laquelle envoyer les rappels
DIRECTOR_1_ID=atlan
DIRECTOR_1_NAME=M. Atlan
DIRECTOR_1_ROLE=Directeur du Primaire
DIRECTOR_1_EMAIL=atlan@exemple.org

DIRECTOR_2_ID=lenny
DIRECTOR_2_NAME=Mme Lenny
DIRECTOR_2_ROLE=Directrice du College/Lycee
DIRECTOR_2_EMAIL=lenny@exemple.org

DIRECTOR_3_ID=pevzner
DIRECTOR_3_NAME=M. Pevzner
DIRECTOR_3_ROLE=Direction generale
DIRECTOR_3_EMAIL=pevzner@exemple.org

DIRECTOR_4_ID=cohen
DIRECTOR_4_NAME=M. Cohen
DIRECTOR_4_ROLE=Intendant
DIRECTOR_4_EMAIL=cohen@exemple.org

# --- Calendrier partage pour les visites de salle ---
# Creez un calendrier Google dedie ("Salle de visite CNJ"), partagez-le avec le compte
# Google du DIRECTOR_ROOM_OWNER_ID ci-dessous en lui donnant le droit "Apporter des
# modifications aux evenements", puis collez son ID de calendrier ici (Parametres du
# calendrier > Integrer l'agenda > ID du calendrier).
ROOM_CALENDAR_ID=
ROOM_CALENDAR_NAME=Salle de visite
ROOM_OWNER_DIRECTOR_ID=pevzner

# --- Acces aux interfaces internes (accueil / tableau de bord) ---
# Code simple demande a l'ecran d'accueil du gardien (poste tablette).
GATEKEEPER_PIN=1234
# Mot de passe pour le tableau de bord des directeurs.
DASHBOARD_PASSWORD=changez-moi

# --- Envoi des emails de rappel (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Accueil CNJ <accueil@exemple.org>"

# Nombre de minutes avant le rendez-vous auquel envoyer le rappel email
REMINDER_MINUTES_BEFORE=10
